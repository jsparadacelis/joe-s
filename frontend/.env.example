# Front end (Next.js): copy to frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000

# Access (RGB-2b). Leave as `dev` for local work: no access screen, no Supabase variables needed.
NEXT_PUBLIC_AUTH_MODE=dev
# Only with NEXT_PUBLIC_AUTH_MODE=supabase (publishable key; never the service_role key):
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key>
