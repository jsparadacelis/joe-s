# Backend (Python). Local: the docker-compose.yml database. On Cloud Run, point it at the Supabase pooler (EU).
DATABASE_URL=postgresql://rgb:rgb@localhost:54329/rgb
CORS_ORIGINS=http://localhost:3000
# Authentication (RGB-2). `dev` (default): every request runs as the fictitious development user.
# `supabase`: every business route needs a Supabase Auth access token; requires SUPABASE_URL.
AUTH_MODE=dev
# SUPABASE_URL=https://<project-ref>.supabase.co
# ENVIRONMENT=production
